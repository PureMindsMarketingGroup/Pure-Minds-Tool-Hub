  "description": "Pure Minds Generator Hub: posts, documenten, presentaties en iconen in de huisstijl (vanilla HTML, CSS en JS)",
  "private": true,
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "brand": "node scripts/build-brand-data.js",
